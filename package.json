{
  "name": "@pleand-inc/style-guide",
  "version": "0.0.10",
  "description": "Pleand code standards: the rules, shared lint and TypeScript configuration, and the RFCs that change them",
  "author": "Pleand Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pleand-inc/style-guide.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "style-guide": "cli/style-guide.mjs"
  },
  "exports": {
    "./biome": "./biome/shared.json",
    "./tsconfig": "./tsconfig/base.json",
    "./tsconfig/web": "./tsconfig/web.json",
    "./tsconfig/node": "./tsconfig/node.json"
  },
  "files": [
    "README.md",
    "biome",
    "cli",
    "tsconfig",
    "rules"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "test:flow": "node --test \"test/cli/*.test.mjs\"",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "6.0.3",
    "zod": "4.6.5"
  },
  "license": "MPL-2.0"
}
